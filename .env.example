# Same Supabase project as the host app (Project Settings > API). Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Where hosts sign in (used for links in emails and "open host app").
VITE_HOST_APP_URL=https://tv.mrserengeti.com
